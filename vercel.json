{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/assets/:path*",
      "destination": "/dist/assets/:path*"
    },
    {
      "source": "/icon.svg",
      "destination": "/dist/icon.svg"
    },
    {
      "source": "/favicon-32x32.png",
      "destination": "/dist/favicon-32x32.png"
    },
    {
      "source": "/favicon-16x16.png",
      "destination": "/dist/favicon-16x16.png"
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/dist/apple-touch-icon.png"
    },
    {
      "source": "/icon-192.png",
      "destination": "/dist/icon-192.png"
    },
    {
      "source": "/icon-512.png",
      "destination": "/dist/icon-512.png"
    },
    {
      "source": "/manifest.json",
      "destination": "/dist/manifest.json"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/dist/index.html"
    }
  ]
}
